# Metadata the helper scripts and COPR setup read. Not consumed by rpmbuild.
PACKAGE_NAME=gaffer
SPEC_FILE=gaffer.spec
UPSTREAM_GIT=https://github.com/mineiro/gaffer.git
UPSTREAM_RELEASES=https://github.com/mineiro/gaffer/releases

# Every package here builds into one project. The repository and the COPR
# project are the same thing to anyone using them, which is one fewer mapping
# to keep in your head and one chroot set to maintain rather than N.
COPR_PROJECT=mineiro/rpms
COPR_PACKAGE=gaffer
COPR_SUBDIR=packages/gaffer
COPR_METHOD=make_srpm
